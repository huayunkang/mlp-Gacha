PORT=3000
DERPIBOORU_BASE_URL=https://derpibooru.org
CACHE_DIR=./cache
CACHE_TTL_DAYS=14
CACHE_MAX_SIZE_MB=5000
RANDOM_POOL_SIZE=20
REQUEST_TIMEOUT_MS=10000
REQUEST_RETRIES=2
MAX_IMAGE_SIZE_MB=25
# Optional server-side HTTP proxy; never use VITE_ variables for secrets.
# HTTPS_PROXY=http://127.0.0.1:7890
# Set only behind a trusted reverse proxy (number of proxy hops).
TRUST_PROXY_HOPS=0
